<Window x:Class="FoxuMarsDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FOXU // MARS DISPLAY"
        Icon="pack://application:,,,/FoxuMarsDisplay;component/Resources/foxu_mars_icon.ico"
        Width="1160" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgObsidian}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderHairline}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2" />
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top 2px Foxu x Mars Laser Accent Bar -->
            <Border Grid.Row="0" Background="{StaticResource FoxuMarsGradient}" />

            <!-- Cyber-HUD Header -->
            <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/FoxuMarsDisplay;component/Resources/foxu_mars_icon_256.png"
                               Width="28" Height="28" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="FOXU" FontSize="15" FontWeight="Bold" Foreground="{StaticResource FoxuEmber}" />
                        <TextBlock Text=" // " FontSize="15" FontWeight="Bold" Foreground="{StaticResource SolarGold}" />
                        <TextBlock Text="MARS DISPLAY" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <Border Background="#15121F" BorderBrush="#2E273F" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="12,0,0,0">
                            <TextBlock x:Name="TxtHeaderStatus" Text="MOTOR ACTIVO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EmeraldLive}" />
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#15121F" BorderBrush="#2E273F" BorderThickness="1" CornerRadius="6" Padding="12,4">
                        <TextBlock x:Name="TxtQuickTelemetry"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="CPU --°C | GPU --°C | RAM --%" />
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnElevate" Content="{DynamicResource Str_AdminPawnIO}" Height="28" Margin="0,0,8,0" Style="{StaticResource CyberButton}" Padding="10,0" Click="OnElevateClick" />
                        <Button Content="─" Width="34" Height="28" Margin="0,0,4,0" Style="{StaticResource CyberButton}" Padding="0" Click="OnMinimizeClick" />
                        <Button Content="□" Width="34" Height="28" Margin="0,0,4,0" Style="{StaticResource CyberButton}" Padding="0" Click="OnMaximizeClick" />
                        <Button Content="✕" Width="34" Height="28" Style="{StaticResource AccentButton}" Padding="0" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body: Nav Rail + Content -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Nav Rail -->
                <Border Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="0,0,1,0" Padding="0,14,0,14">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <RadioButton x:Name="NavScreens" Content="{DynamicResource Str_NavScreens}" IsChecked="True" Style="{StaticResource NavTabRadio}" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavGallery" Content="{DynamicResource Str_NavGallery}" Style="{StaticResource NavTabRadio}" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavCloud" Content="{DynamicResource Str_NavCloud}" Style="{StaticResource NavTabRadio}" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavTelemetry" Content="{DynamicResource Str_NavTelemetry}" Style="{StaticResource NavTabRadio}" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavSystem" Content="{DynamicResource Str_NavSystem}" Style="{StaticResource NavTabRadio}" Checked="OnNavChecked" />
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" Margin="12,0" Padding="10" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="IPC NAMED PIPE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource FoxuEmber}" />
                                <TextBlock Text="FoxuMarsDisplay_IPC_v1" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Main Pages -->
                <Grid Grid.Column="1" Margin="18">
                    <!-- TAB 1: PANTALLAS -->
                    <ScrollViewer x:Name="PageScreens" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource Str_ScreensTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="{DynamicResource Str_Refresh}" Style="{StaticResource CyberButton}" Click="OnRefreshScreensClick" />
                            </DockPanel>

                            <ItemsControl x:Name="ScreensList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Live Hardware Bezel Preview -->
                                                <Border Width="136" Height="164" Background="#0D0B12" BorderBrush="#2E273F" BorderThickness="2" CornerRadius="6" Padding="4" Margin="0,0,16,0" Cursor="Hand" ToolTip="{DynamicResource Str_ClickToZoom}" Tag="{Binding}" MouseLeftButtonUp="OnPreviewImageClick">
                                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ScreenTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                                            <Border Background="#211C2E" BorderBrush="{StaticResource FoxuEmber}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding ResolutionText}" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource SolarGold}" />
                                                            </Border>
                                                            <Border Background="#1E182B" BorderBrush="#2E273F" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding OrientationLabel}" FontSize="11" FontWeight="Bold" Foreground="{Binding OrientationBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                                  Content="{DynamicResource Str_ScreenOn}"
                                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                  Foreground="{StaticResource TextPrimary}"
                                                                  Tag="{Binding SerialNumber}"
                                                                  Click="OnToggleScreenEnabledClick" />
                                                    </DockPanel>

                                                    <TextBlock Text="{Binding HardwareSubline}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />
                                                    <TextBlock Text="{Binding ThemeSummary}" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding StatsText}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" />

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="120" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{DynamicResource Str_Brightness}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" />
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Brightness, Mode=OneWay}" Tag="{Binding SerialNumber}" ValueChanged="OnBrightnessChanged" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{DynamicResource Str_Rotation}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="18,0,8,0" />
                                                        <ComboBox Grid.Column="3" SelectedIndex="{Binding Rotation, Mode=OneWay}" Tag="{Binding SerialNumber}" SelectionChanged="OnRotationChanged">
                                                            <ComboBoxItem Content="0°" />
                                                            <ComboBoxItem Content="90°" />
                                                            <ComboBoxItem Content="180°" />
                                                            <ComboBoxItem Content="270°" />
                                                        </ComboBox>
                                                    </Grid>

                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="{DynamicResource Str_PickTheme}" Style="{StaticResource AccentButton}" Tag="{Binding SerialNumber}" Click="OnPickThemeForScreenClick" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TxtNoScreens"
                                       Visibility="Collapsed"
                                       Text="{DynamicResource Str_NoScreens}"
                                       Foreground="{StaticResource AmberWarn}"
                                       FontSize="13"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 2: GALERIA UNIFICADA -->
                    <Grid x:Name="PageGallery" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Str_GalleryTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox x:Name="TxtGallerySearch" Width="190" TextChanged="OnGallerySearchChanged" Margin="0,0,8,0" />
                                <ComboBox x:Name="CmbGalleryResolution" Width="150" DisplayMemberPath="Label" SelectionChanged="OnGalleryResolutionChanged" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource Str_Target}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" />
                                <ComboBox x:Name="CmbTargetScreen" Width="260" Margin="0,0,8,0" DisplayMemberPath="DisplayLabel" SelectionChanged="OnTargetScreenChanged">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <Button Content="{DynamicResource Str_Scan}" Style="{StaticResource CyberButton}" Click="OnRescanGalleryClick" />
                            </StackPanel>
                        </DockPanel>

                        <!-- 3-Category Orientation & Compatibility Filter Pills -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <RadioButton x:Name="FilterAll" Content="Todos (0)" IsChecked="True" Style="{StaticResource FilterPillRadio}" Checked="OnOrientationFilterChanged" Margin="0,0,6,6" />
                            <RadioButton x:Name="FilterCompatible" Content="🎯 Compatible (0)" Style="{StaticResource FilterPillRadio}" Checked="OnOrientationFilterChanged" Margin="0,0,6,6" />
                            <RadioButton x:Name="FilterVertical" Content="↕ Vertical (0)" Style="{StaticResource FilterPillRadio}" Checked="OnOrientationFilterChanged" Margin="0,0,6,6" />
                            <RadioButton x:Name="FilterHorizontal" Content="↔ Horizontal (0)" Style="{StaticResource FilterPillRadio}" Checked="OnOrientationFilterChanged" Margin="0,0,6,6" />
                            <RadioButton x:Name="FilterSquare" Content="▢ Cuadrado (0)" Style="{StaticResource FilterPillRadio}" Checked="OnOrientationFilterChanged" Margin="0,0,6,6" />
                        </WrapPanel>

                        <ListBox x:Name="GalleryList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,10,10" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="216" Style="{StaticResource ThemeCardBorder}">
                                        <StackPanel>
                                            <Border Height="162" Background="#0D0B12" BorderBrush="#2E273F" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" ClipToBounds="True" Cursor="Hand" ToolTip="{DynamicResource Str_ClickToZoom}" Tag="{Binding}" MouseLeftButtonUp="OnPreviewImageClick">
                                                <Grid>
                                                    <TextBlock Text="{Binding MetaText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas" Foreground="#4A3F63" TextWrapping="Wrap" TextAlignment="Center" Margin="8" />
                                                    <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" />
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4" Background="#CC0F291E" BorderBrush="{StaticResource EmeraldLive}" BorderThickness="1" Visibility="{Binding ExactVisibility}">
                                                        <TextBlock Text="{DynamicResource Str_BadgeExact}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource EmeraldLive}" />
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4" Background="#CC13111A" BorderBrush="#2E273F" BorderThickness="1">
                                                        <TextBlock Text="{Binding OrientationBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding OrientationBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MetaText}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource SolarGold}" Margin="0,3,0,8" />
                                            <Button Content="{DynamicResource Str_ApplyOnScreen}" Style="{StaticResource CyberButton}" Tag="{Binding}" Click="OnApplyGalleryThemeClick" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- TAB 3: DESCARGAR TEMAS (SOEYI + HUGGINGFACE) -->
                    <Grid x:Name="PageCloud" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Str_CloudTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="TxtCloudSearch" Width="150" TextChanged="OnCloudSearchChanged" Margin="0,0,8,0" />
                                <ComboBox x:Name="CmbCloudSource" Width="195" SelectionChanged="OnCloudSourceChanged" Margin="0,0,8,0">
                                    <ComboBoxItem Content="{DynamicResource Str_SourceAuto}" IsSelected="True" />
                                    <ComboBoxItem Content="{DynamicResource Str_SourceHF}" />
                                    <ComboBoxItem Content="{DynamicResource Str_SourceBoth}" />
                                </ComboBox>
                                <ComboBox x:Name="CmbCloudResolution" Width="145" DisplayMemberPath="Label" SelectionChanged="OnCloudResolutionChanged" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource Str_Target}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0" />
                                <ComboBox x:Name="CmbCloudTargetScreen" Width="225" Margin="0,0,8,0" DisplayMemberPath="DisplayLabel" SelectionChanged="OnCloudTargetScreenChanged">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <Button Content="{DynamicResource Str_Update}" Style="{StaticResource CyberButton}" Click="OnReloadCloudClick" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtCloudStatus" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource SolarGold}" Text="{DynamicResource Str_Ready}" Margin="10,0,0,0" />
                            <WrapPanel>
                                <RadioButton x:Name="CloudFilterCompatible" Content="🎯 Compatible (0)" Style="{StaticResource FilterPillRadio}" Checked="OnCloudFilterChanged" Margin="0,0,6,6" />
                                <RadioButton x:Name="CloudFilterVertical" Content="↕ Vertical (0)" Style="{StaticResource FilterPillRadio}" Checked="OnCloudFilterChanged" Margin="0,0,6,6" />
                                <RadioButton x:Name="CloudFilterHorizontal" Content="↔ Horizontal (0)" Style="{StaticResource FilterPillRadio}" Checked="OnCloudFilterChanged" Margin="0,0,6,6" />
                                <RadioButton x:Name="CloudFilterSquare" Content="▢ Cuadrado (0)" Style="{StaticResource FilterPillRadio}" Checked="OnCloudFilterChanged" Margin="0,0,6,6" />
                                <RadioButton x:Name="CloudFilterAll" Content="Todos (0)" IsChecked="True" Style="{StaticResource FilterPillRadio}" Checked="OnCloudFilterChanged" Margin="0,0,6,6" />
                            </WrapPanel>
                        </DockPanel>

                        <ListBox x:Name="CloudList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,10,10" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="216" Style="{StaticResource ThemeCardBorder}">
                                        <StackPanel>
                                            <Border Height="162" Background="#0D0B12" BorderBrush="#2E273F" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" ClipToBounds="True" Cursor="Hand" ToolTip="{DynamicResource Str_ClickToZoom}" Tag="{Binding}" MouseLeftButtonUp="OnPreviewImageClick">
                                                <Grid>
                                                    <TextBlock Text="{Binding MetaText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas" Foreground="#4A3F63" TextWrapping="Wrap" TextAlignment="Center" Margin="8" />
                                                    <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                                        <Border Padding="6,2" CornerRadius="4" Background="#CC13111A" BorderBrush="#2E273F" BorderThickness="1">
                                                            <TextBlock Text="{Binding Source}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MarsCrimson}" />
                                                        </Border>
                                                        <Border Margin="4,0,0,0" Padding="6,2" CornerRadius="4" Background="#CC0F291E" BorderBrush="{StaticResource EmeraldLive}" BorderThickness="1" Visibility="{Binding ExactVisibility}">
                                                            <TextBlock Text="{DynamicResource Str_BadgeExact}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource EmeraldLive}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4" Background="#CC13111A" BorderBrush="#2E273F" BorderThickness="1">
                                                        <TextBlock Text="{Binding OrientationBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding OrientationBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MetaText}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource SolarGold}" Margin="0,3,0,8" />
                                            <Button Content="{Binding ActionText}" IsEnabled="{Binding CanClick}" Style="{StaticResource CyberButton}" Tag="{Binding}" Click="OnDownloadAndApplyCloudClick" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- TAB 4: TELEMETRIA -->
                    <ScrollViewer x:Name="PageTelemetry" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_TelTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />
                            <WrapPanel>
                                <Border Width="260" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="CPU" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MarsCrimson}" />
                                        <TextBlock x:Name="TxtTelCpuTemp" Text="-- °C" FontSize="28" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,2" />
                                        <TextBlock x:Name="TxtTelCpuSub" Text="Uso: --% | Potencia: -- W" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </Border>
                                <Border Width="260" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="GPU (NVML)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SolarGold}" />
                                        <TextBlock x:Name="TxtTelGpuTemp" Text="-- °C" FontSize="28" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,2" />
                                        <TextBlock x:Name="TxtTelGpuSub" Text="Uso: --% | Potencia: -- W" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </Border>
                                <Border Width="260" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str_MemNet}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PlasmaViolet}" />
                                        <TextBlock x:Name="TxtTelRam" Text="-- %" FontSize="28" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,2" />
                                        <TextBlock x:Name="TxtTelNet" Text="↓ -- KB/s | ↑ -- KB/s" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 5: SISTEMA -->
                    <ScrollViewer x:Name="PageSystem" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Str_SysTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock Text="{DynamicResource Str_LanguageLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox x:Name="CmbLanguage" Width="260" HorizontalAlignment="Right" SelectionChanged="OnLanguageChanged">
                                            <ComboBoxItem Tag="auto" Content="{DynamicResource Str_LangAuto}" />
                                            <ComboBoxItem Tag="es" Content="Español (ES)" />
                                            <ComboBoxItem Tag="en" Content="English (EN)" />
                                            <ComboBoxItem Tag="fr" Content="Français (FR)" />
                                            <ComboBoxItem Tag="de" Content="Deutsch (DE)" />
                                            <ComboBoxItem Tag="pt" Content="Português (PT)" />
                                        </ComboBox>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock x:Name="TxtFpsLabel" Text="FPS Animación: 12 FPS" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Slider x:Name="SldTargetFps" Minimum="5" Maximum="30" Width="260" HorizontalAlignment="Right" ValueChanged="OnTargetFpsChanged" />
                                    </DockPanel>
                                    <CheckBox x:Name="ChkPauseFullscreen" Content="{DynamicResource Str_PauseFullscreen}" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" Click="OnSystemFlagsChanged" />
                                    <CheckBox x:Name="ChkMinimizeToTray" Content="{DynamicResource Str_MinimizeToTray}" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" Click="OnSystemFlagsChanged" />
                                    <CheckBox x:Name="ChkAutoStart" Content="{DynamicResource Str_AutoStart}" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" Click="OnAutoStartChanged" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{DynamicResource Str_ClearCache}" Style="{StaticResource CyberButton}" Margin="0,0,10,0" Click="OnClearCacheClick" />
                                        <Button Content="{DynamicResource Str_KillSoeyi}" Style="{StaticResource AccentButton}" Click="OnKillSoeyiClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Click-to-Zoom Full-Resolution Lightbox Overlay -->
            <Grid x:Name="LightboxOverlay"
                  Grid.Row="1" Grid.RowSpan="2"
                  Background="#E60B0A0F"
                  Visibility="Collapsed"
                  Cursor="Hand"
                  MouseLeftButtonUp="OnLightboxClick">
                <Border Background="#171421"
                        BorderBrush="{StaticResource FoxuEmber}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Padding="14"
                        MaxWidth="960"
                        MaxHeight="680"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtLightboxTitle" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="TxtLightboxMeta" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource SolarGold}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{DynamicResource Str_LightboxHint}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}" />
                        </DockPanel>

                        <Border Grid.Row="1" Background="#0D0B12" BorderBrush="#2E273F" BorderThickness="1" CornerRadius="6" Padding="6">
                            <Image x:Name="ImgLightbox" Stretch="Uniform" MaxHeight="580" MaxWidth="900" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
