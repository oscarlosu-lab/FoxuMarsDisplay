<Window x:Class="FoxuMarsDisplay.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FOXU // STUDIO — Editor Visual de Temas"
        Width="1160" Height="740" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgObsidian}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnEditorPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="EditorToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#15121F" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FoxuEmber}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A1C12" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FoxuEmber}" />
                                <Setter Property="Foreground" Value="{StaticResource SolarGold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="310" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: Theme Setup, Add Widgets & Layers -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="TEMA Y RESOLUCIÓN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FoxuEmber}" Margin="0,0,0,6" />
                    <TextBlock Text="Nombre" FontSize="11" Foreground="{StaticResource TextMuted}" />
                    <TextBox x:Name="TxtThemeName" Text="FoxuCustomHUD" Margin="0,2,0,8" Padding="6,4" Background="#15121F" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderHairline}" TextChanged="OnThemeMetaChanged" />

                    <TextBlock Text="Resolución del Lienzo" FontSize="11" Foreground="{StaticResource TextMuted}" />
                    <ComboBox x:Name="CmbResolution" Margin="0,2,0,8" SelectionChanged="OnResolutionChanged">
                        <ComboBoxItem Content="360x960" IsSelected="True" />
                        <ComboBoxItem Content="240x320" />
                        <ComboBoxItem Content="320x240" />
                        <ComboBoxItem Content="480x480" />
                        <ComboBoxItem Content="480x320" />
                        <ComboBoxItem Content="320x1480" />
                        <ComboBoxItem Content="462x1920" />
                        <ComboBoxItem Content="480x1920" />
                        <ComboBoxItem Content="720x1472" />
                        <ComboBoxItem Content="800x480" />
                        <ComboBoxItem Content="1024x600" />
                    </ComboBox>
                    <CheckBox x:Name="ChkScaleWidgets" Content="Escalar widgets al cambiar res." IsChecked="True" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="🖼️ Fondo (IMG/MP4)" Height="30" Style="{StaticResource CyberButton}" Click="OnPickBackgroundClick" />
                        <Button Grid.Column="1" Content="✕" Width="32" Height="30" Margin="6,0,0,0" ToolTip="Quitar fondo" Style="{StaticResource CyberButton}" Click="OnClearBackgroundClick" />
                    </Grid>
                    <Button Content="📂 Abrir Tema (.smtheme)" Height="32" Margin="0,0,0,10" Style="{StaticResource CyberButton}" Click="OnOpenSmthemeClick" />

                    <TextBlock Text="AÑADIR WIDGETS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SolarGold}" Margin="0,0,0,6" />
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="+ Texto" Margin="0,0,4,4" Height="28" Padding="6,2" Style="{StaticResource CyberButton}" Click="OnAddSensorTextClick" />
                        <Button Content="+ Etiqueta" Margin="0,0,0,4" Height="28" Padding="6,2" Style="{StaticResource CyberButton}" Click="OnAddStaticTextClick" />
                        <Button Content="+ Barra" Margin="0,0,4,4" Height="28" Padding="6,2" Style="{StaticResource CyberButton}" Click="OnAddBarClick" />
                        <Button Content="+ Tarjeta" Margin="0,0,0,4" Height="28" Padding="6,2" Style="{StaticResource CyberButton}" Click="OnAddCardClick" />
                        <Button Content="+ Anillo" Margin="0,0,4,4" Height="28" Padding="6,2" Style="{StaticResource CyberButton}" Click="OnAddRadialClick" />
                        <Button Content="+ Gráfico" Margin="0,0,0,4" Height="28" Padding="6,2" Style="{StaticResource CyberButton}" Click="OnAddGraphClick" />
                        <Button Content="+ Audio FFT" Margin="0,0,4,0" Height="28" Padding="6,2" Style="{StaticResource CyberButton}" Click="OnAddAudioClick" />
                        <Button Content="+ Vinilo" Margin="0" Height="28" Padding="6,2" Style="{StaticResource CyberButton}" Click="OnAddAlbumArtClick" />
                    </UniformGrid>

                    <DockPanel Margin="0,4,0,4">
                        <TextBlock Text="CAPAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Eliminar" Height="22" Padding="8,0" Style="{StaticResource CyberButton}" Click="OnDeleteWidgetClick" />
                    </DockPanel>
                </StackPanel>

                <ListBox x:Name="LstLayers" Background="#120F1B" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderHairline}" SelectionChanged="OnLayerSelected" />
            </DockPanel>
        </Border>

        <!-- CENTER: WYSIWYG Drag-and-Drop Preview Canvas -->
        <Border Grid.Row="0" Grid.Column="1" Margin="12,0" Background="#0A090E" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="VISTA PREVIA EN VIVO (arrastra los widgets sobre el lienzo)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <Viewbox Grid.Row="1" Stretch="Uniform">
                    <Image x:Name="ImgPreviewCanvas" Stretch="None" Cursor="SizeAll"
                           MouseLeftButtonDown="OnCanvasMouseDown"
                           MouseMove="OnCanvasMouseMove"
                           MouseLeftButtonUp="OnCanvasMouseUp" />
                </Viewbox>
            </Grid>
        </Border>

        <!-- RIGHT: Widget Properties Inspector -->
        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="PROPIEDADES DEL WIDGET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FoxuEmber}" Margin="0,0,0,8" />
                    <TextBlock x:Name="TxtSelectedKind" Text="Ningún widget seleccionado" FontSize="11" Foreground="{StaticResource SolarGold}" Margin="0,0,0,10" />

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="X" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            <TextBox x:Name="TxtPropX" Padding="5,3" Background="#15121F" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderHairline}" LostFocus="OnPropEdited" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Y" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            <TextBox x:Name="TxtPropY" Padding="5,3" Background="#15121F" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderHairline}" LostFocus="OnPropEdited" />
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Ancho" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            <TextBox x:Name="TxtPropW" Padding="5,3" Background="#15121F" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderHairline}" LostFocus="OnPropEdited" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Alto / Tamaño" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            <TextBox x:Name="TxtPropH" Padding="5,3" Background="#15121F" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderHairline}" LostFocus="OnPropEdited" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Sensor" FontSize="11" Foreground="{StaticResource TextMuted}" />
                    <ComboBox x:Name="CmbPropSensor" Margin="0,2,0,8" SelectionChanged="OnPropEdited">
                        <ComboBoxItem Tag="" Content="(Ninguno — Texto fijo)" />
                        <ComboBoxItem Content="CPUTemp" />
                        <ComboBoxItem Content="CpuUsage" />
                        <ComboBoxItem Content="GPUTemp" />
                        <ComboBoxItem Content="GpuUsage" />
                        <ComboBoxItem Content="GPUMemoryLoad" />
                        <ComboBoxItem Content="MemoryUsage" />
                        <ComboBoxItem Content="MemoryUsed" />
                        <ComboBoxItem Content="DiskCUsed" />
                        <ComboBoxItem Content="NetDown" />
                        <ComboBoxItem Content="NetUp" />
                        <ComboBoxItem Content="Ping" />
                        <ComboBoxItem Content="WeatherInfo" />
                        <ComboBoxItem Content="WEATHER_TEMP" />
                        <ComboBoxItem Content="WEATHER_CITY" />
                        <ComboBoxItem Content="WEATHER_HUMIDITY" />
                        <ComboBoxItem Content="HEIGHTWEATHER" />
                        <ComboBoxItem Content="NIGHTWEATHER" />
                        <ComboBoxItem Content="SongTitle" />
                        <ComboBoxItem Content="Artist" />
                        <ComboBoxItem Content="SongLyric" />
                        <ComboBoxItem Content="AI_CLAUDE" />
                        <ComboBoxItem Content="AI_CODEX" />
                        <ComboBoxItem Content="AI_GEMINI" />
                        <ComboBoxItem Content="Time" />
                        <ComboBoxItem Content="CurrentDateS" />
                        <ComboBoxItem Content="Uptime" />
                    </ComboBox>

                    <Border x:Name="PnlTextFormatting" Background="#120F1B" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="ESTILO DE TEXTO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SolarGold}" Margin="0,0,0,5" />
                            <TextBlock Text="Fuente" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            <ComboBox x:Name="CmbPropFont" Margin="0,2,0,6" MaxDropDownHeight="300"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      SelectionChanged="OnPropEdited">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontFamily="{Binding PreviewFont}"
                                                   FontSize="13"
                                                   Height="20"
                                                   LineHeight="20"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tamaño" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button x:Name="BtnFontSizeDec" Grid.Column="1" Content="−" Width="26" Height="26" Padding="0" Margin="0,0,3,0" ToolTip="Reducir tamaño (-2 px)" Style="{StaticResource CyberButton}" Click="OnFontSizeDecClick" />
                                <TextBox x:Name="TxtPropFontSize" Grid.Column="2" Padding="4,3" HorizontalContentAlignment="Center" Background="#15121F" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderHairline}" LostFocus="OnPropEdited" />
                                <Button x:Name="BtnFontSizeInc" Grid.Column="3" Content="+" Width="26" Height="26" Padding="0" Margin="3,0,5,0" ToolTip="Aumentar tamaño (+2 px)" Style="{StaticResource CyberButton}" Click="OnFontSizeIncClick" />
                                <ComboBox x:Name="CmbPropFontSize" Grid.Column="4" Height="26" Padding="6,2" ToolTip="Tamaños predefinidos" SelectionChanged="OnFontSizePresetChanged">
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="12" />
                                    <ComboBoxItem Content="14" />
                                    <ComboBoxItem Content="16" />
                                    <ComboBoxItem Content="18" />
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="22" />
                                    <ComboBoxItem Content="24" />
                                    <ComboBoxItem Content="28" />
                                    <ComboBoxItem Content="32" />
                                    <ComboBoxItem Content="36" />
                                    <ComboBoxItem Content="42" />
                                    <ComboBoxItem Content="48" />
                                    <ComboBoxItem Content="56" />
                                    <ComboBoxItem Content="64" />
                                    <ComboBoxItem Content="72" />
                                    <ComboBoxItem Content="96" />
                                    <ComboBoxItem Content="120" />
                                </ComboBox>
                            </Grid>
                            <UniformGrid Columns="5" Margin="0,0,0,6">
                                <ToggleButton x:Name="TglBold" Content="B" FontWeight="Bold" Margin="0,0,3,0" ToolTip="Negrita" Style="{StaticResource EditorToggleStyle}" Click="OnPropEdited" />
                                <ToggleButton x:Name="TglItalic" Content="I" FontStyle="Italic" Margin="0,0,3,0" ToolTip="Cursiva" Style="{StaticResource EditorToggleStyle}" Click="OnPropEdited" />
                                <ToggleButton x:Name="TglUnderline" Margin="0,0,3,0" ToolTip="Subrayado" Style="{StaticResource EditorToggleStyle}" Click="OnPropEdited">
                                    <TextBlock Text="U" TextDecorations="Underline" />
                                </ToggleButton>
                                <ToggleButton x:Name="TglStrikeout" Margin="0,0,3,0" ToolTip="Tachado" Style="{StaticResource EditorToggleStyle}" Click="OnPropEdited">
                                    <TextBlock Text="S" TextDecorations="Strikethrough" />
                                </ToggleButton>
                                <ToggleButton x:Name="TglShadow" Content="Sombra" FontSize="10" ToolTip="Sombra para mayor contraste" Style="{StaticResource EditorToggleStyle}" Click="OnPropEdited" />
                            </UniformGrid>
                            <UniformGrid Columns="4">
                                <ToggleButton x:Name="TglAlignLeft" Content="⫷" Margin="0,0,3,0" ToolTip="Alinear a la izquierda" Style="{StaticResource EditorToggleStyle}" Click="OnAlignLeftClick" />
                                <ToggleButton x:Name="TglAlignCenter" Content="☰" Margin="0,0,3,0" ToolTip="Centrar texto" Style="{StaticResource EditorToggleStyle}" Click="OnAlignCenterClick" />
                                <ToggleButton x:Name="TglAlignRight" Content="⫸" Margin="0,0,3,0" ToolTip="Alinear a la derecha" Style="{StaticResource EditorToggleStyle}" Click="OnAlignRightClick" />
                                <Button x:Name="BtnCenterTextCanvas" Content="↔" Height="28" Padding="4,0" ToolTip="Centrar en todo el ancho de la pantalla" Style="{StaticResource CyberButton}" Click="OnCenterOnCanvasClick" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnCenterWidgetCanvas" Content="↔ Centrar horizontalmente" Height="26" Margin="0,0,0,8" Visibility="Collapsed" Style="{StaticResource CyberButton}" Click="OnCenterOnCanvasClick" />

                    <TextBlock Text="Prefijo / Texto Fijo" FontSize="11" Foreground="{StaticResource TextMuted}" />
                    <TextBox x:Name="TxtPropText" Margin="0,2,0,8" Padding="5,3" Background="#15121F" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderHairline}" LostFocus="OnPropEdited" />

                    <TextBlock Text="Unidad" FontSize="11" Foreground="{StaticResource TextMuted}" />
                    <TextBox x:Name="TxtPropUnit" Margin="0,2,0,8" Padding="5,3" Background="#15121F" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderHairline}" LostFocus="OnPropEdited" />

                    <TextBlock Text="Color Principal (#AARRGGBB)" FontSize="11" Foreground="{StaticResource TextMuted}" />
                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="BtnColorDropDown" Height="26" Margin="0,0,5,0" ToolTip="Abrir paleta de colores" Style="{StaticResource EditorToggleStyle}" Click="OnOpenColorPaletteClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="SwatchPropColor" Width="16" Height="16" CornerRadius="3" BorderBrush="#4C4266" BorderThickness="1" Background="#FFFFFFFF" Margin="0,0,4,0" />
                                <TextBlock Text="▾" Foreground="#FF6419" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <TextBox x:Name="TxtPropColor" Grid.Column="1" Padding="5,3" Background="#15121F" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderHairline}" LostFocus="OnPropEdited" TextChanged="OnColorHexTextChanged" />
                        <Button Grid.Column="2" Content="Auto" Margin="5,0,0,0" Height="26" Padding="8,0" ToolTip="Auto-Contraste WCAG" Style="{StaticResource CyberButton}" Click="OnAutoContrastClick" />
                    </Grid>

                    <TextBlock Text="Color Fondo (#AARRGGBB)" FontSize="11" Foreground="{StaticResource TextMuted}" />
                    <Grid Margin="0,2,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="BtnBackColorDropDown" Height="26" Margin="0,0,5,0" ToolTip="Abrir paleta de color de fondo" Style="{StaticResource EditorToggleStyle}" Click="OnOpenBackColorPaletteClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="SwatchPropBackColor" Width="16" Height="16" CornerRadius="3" BorderBrush="#4C4266" BorderThickness="1" Background="#C8261F33" Margin="0,0,4,0" />
                                <TextBlock Text="▾" Foreground="#FF6419" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <TextBox x:Name="TxtPropBackColor" Grid.Column="1" Padding="5,3" Background="#15121F" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderHairline}" LostFocus="OnPropEdited" TextChanged="OnColorHexTextChanged" />
                    </Grid>

                    <Popup x:Name="ColorPickerPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="OnColorPopupClosed">
                        <Border Background="#171421" BorderBrush="#FF6419" BorderThickness="1" CornerRadius="8" Padding="10" Width="264">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtColorPopupTitle" Text="Paleta de Color" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SolarGold}" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="Transparente" Height="22" Padding="8,0" FontSize="10" HorizontalAlignment="Right" Style="{StaticResource CyberButton}" Click="OnPickTransparentColorClick" />
                                </DockPanel>
                                <UniformGrid x:Name="ColorPaletteGrid" Columns="8" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Rojo" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <Slider x:Name="SldColorR" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnColorSliderChanged" />
                                    <TextBlock x:Name="TxtColorR" Grid.Column="2" Text="255" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Verde" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <Slider x:Name="SldColorG" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnColorSliderChanged" />
                                    <TextBlock x:Name="TxtColorG" Grid.Column="2" Text="255" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Azul" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <Slider x:Name="SldColorB" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnColorSliderChanged" />
                                    <TextBlock x:Name="TxtColorB" Grid.Column="2" Text="255" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Opacidad" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <Slider x:Name="SldColorA" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnColorSliderChanged" />
                                    <TextBlock x:Name="TxtColorA" Grid.Column="2" Text="255" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Content="Actualizar Vista" Height="30" Style="{StaticResource CyberButton}" Click="OnRefreshPreviewClick" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- BOTTOM BAR -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                    <Button Content="Exportar Setting.txt" Height="32" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource CyberButton}" Click="OnExportSettingTxtClick" />
                    <Button Content="Exportar .smtheme" Height="32" Padding="10,4" Margin="0,0,10,0" Style="{StaticResource CyberButton}" Click="OnExportSmthemeClick" />
                    <TextBlock Text="Pantalla:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0" />
                    <ComboBox x:Name="CmbTargetScreen" MinWidth="210" MaxWidth="280" Height="32" Margin="0,0,8,0" VerticalContentAlignment="Center" SelectionChanged="OnTargetScreenChanged" />
                    <Button Content="⚡ Aplicar en Pantalla" Height="32" Padding="12,4" Style="{StaticResource AccentButton}" Click="OnApplyToScreenClick" />
                </StackPanel>
                <TextBlock x:Name="TxtEditorStatus" Text="Listo. Arrastra widgets, flechas mover, Supr borrar, Ctrl+D duplicar." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
