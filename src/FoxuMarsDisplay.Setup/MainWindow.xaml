<Window x:Class="FoxuMarsDisplay.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FOXU // MARS DISPLAY — Instalador"
        Width="600" SizeToContent="Height" MinHeight="480"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#07090E"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI">
    <Border BorderBrush="#1F293D" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="10" Height="10" CornerRadius="2" Background="#FF1E42" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="FOXU" FontSize="18" FontWeight="Bold" Foreground="#00E5FF" />
                    <TextBlock Text=" // " FontSize="18" FontWeight="Bold" Foreground="#FF1E42" />
                    <TextBlock Text="MARS DISPLAY SETUP" FontSize="18" FontWeight="Bold" Foreground="#F1F5F9" />
                </StackPanel>
                <TextBlock x:Name="TxtSubtitle" Text="Instalación permanente en Program Files + arranque automático sin UAC (como SOEYI)" FontSize="12" Foreground="#8A99B0" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Background="#0E131D" BorderBrush="#1F293D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,16">
                <StackPanel x:Name="OptionsPanel">
                    <TextBlock Text="Ruta de instalación:" FontSize="12" Foreground="#8A99B0" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtInstallDir" IsReadOnly="True" Background="#161E2E" Foreground="#00E5FF" BorderBrush="#26334D" Padding="8,6" FontFamily="Consolas" FontSize="12" Margin="0,0,0,14" />

                    <CheckBox x:Name="ChkDesktopShortcut" Content="Crear acceso directo en el Escritorio (FoxuMarsDisplay)" IsChecked="True" Foreground="#F1F5F9" Margin="0,0,0,10" />
                    <CheckBox x:Name="ChkAutoBoot" Content="Iniciar automáticamente con Windows en bandeja (sin UAC)" IsChecked="True" Foreground="#F1F5F9" Margin="0,0,0,10" />
                    <CheckBox x:Name="ChkDisableSoeyi" Content="Desactivar autoarranque de SOEYI (SOEYIPowerBoot)" IsChecked="False" Foreground="#F59E0B" Margin="0,0,0,10" />
                    <CheckBox x:Name="ChkLaunchAfter" Content="Abrir FoxuMarsDisplay al terminar" IsChecked="True" Foreground="#F1F5F9" Margin="0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="TxtStatus" Text="Listo para instalar" FontSize="12" Foreground="#00E5FF" Margin="0,0,0,6" />
                <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="100" Value="0" Background="#161E2E" Foreground="#FF1E42" BorderBrush="#26334D" Margin="0,0,0,14" />
                <DockPanel>
                    <Button x:Name="BtnCancel" Content="Cerrar" Width="100" Height="34" Background="#161E2E" Foreground="#F1F5F9" BorderBrush="#26334D" Click="OnCancelClick" />
                    <Button x:Name="BtnAction" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Instalar ahora" Width="160" Height="34" Background="#FF1E42" Foreground="#FFFFFF" FontWeight="Bold" BorderBrush="#FF4D6A" Click="OnActionClick" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
