<Window x:Class="FoxuMarsDisplay.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FOXU // MARS DISPLAY — Instalador"
        Width="600" SizeToContent="Height" MinHeight="480"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#0B0A0F"
        Foreground="#F7F5FC"
        FontFamily="Segoe UI">
    <Border BorderBrush="#2E273F" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="10" Height="10" CornerRadius="2" Background="#FF6419" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="FOXU" FontSize="18" FontWeight="Bold" Foreground="#FF6419" />
                    <TextBlock Text=" // " FontSize="18" FontWeight="Bold" Foreground="#FFB820" />
                    <TextBlock Text="MARS DISPLAY SETUP" FontSize="18" FontWeight="Bold" Foreground="#F7F5FC" />
                </StackPanel>
                <TextBlock x:Name="TxtSubtitle" Text="Instalación permanente en Program Files + arranque automático sin UAC (como SOEYI)" FontSize="12" Foreground="#988FAD" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Background="#171421" BorderBrush="#2E273F" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,16">
                <StackPanel x:Name="OptionsPanel">
                    <TextBlock x:Name="TxtInstallDirLabel" Text="Ruta de instalación:" FontSize="12" Foreground="#988FAD" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtInstallDir" IsReadOnly="True" Background="#211C2E" Foreground="#FFB820" BorderBrush="#372F4B" Padding="8,6" FontFamily="Consolas" FontSize="12" Margin="0,0,0,14" />

                    <CheckBox x:Name="ChkDesktopShortcut" Content="Crear acceso directo en el Escritorio (FoxuMarsDisplay)" IsChecked="True" Foreground="#F7F5FC" Margin="0,0,0,10" />
                    <CheckBox x:Name="ChkAutoBoot" Content="Iniciar automáticamente con Windows en bandeja (sin UAC)" IsChecked="True" Foreground="#F7F5FC" Margin="0,0,0,10" />
                    <CheckBox x:Name="ChkDisableSoeyi" Content="Desactivar autoarranque de SOEYI (SOEYIPowerBoot)" IsChecked="False" Foreground="#FFB820" Margin="0,0,0,10" />
                    <CheckBox x:Name="ChkLaunchAfter" Content="Abrir FoxuMarsDisplay al terminar" IsChecked="True" Foreground="#F7F5FC" Margin="0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="TxtStatus" Text="Listo para instalar" FontSize="12" Foreground="#FFB820" Margin="0,0,0,6" />
                <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="100" Value="0" Background="#211C2E" Foreground="#FF6419" BorderBrush="#2E273F" Margin="0,0,0,14" />
                <DockPanel>
                    <Button x:Name="BtnCancel" Content="Cerrar" Width="100" Height="34" Background="#211C2E" Foreground="#F7F5FC" BorderBrush="#372F4B" Click="OnCancelClick" />
                    <Button x:Name="BtnAction" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Instalar ahora" Width="160" Height="34" Background="#FF6419" Foreground="#FFFFFF" FontWeight="Bold" BorderBrush="#FF7A2F" Click="OnActionClick" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
