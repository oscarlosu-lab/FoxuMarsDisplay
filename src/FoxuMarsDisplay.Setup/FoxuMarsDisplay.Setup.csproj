<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\branding\foxu_mars_icon.ico</ApplicationIcon>
    <AssemblyName>FoxuMarsDisplay_Setup</AssemblyName>
    <Version>1.1.0</Version>
    <Product>FoxuMarsDisplay</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\branding\foxu_mars_icon.ico" Link="Resources\foxu_mars_icon.ico" />
    <Resource Include="..\..\assets\branding\foxu_mars_icon_256.png" Link="Resources\foxu_mars_icon_256.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" LogicalName="FoxuMarsDisplay.Setup.payload.zip" />
  </ItemGroup>
</Project>
